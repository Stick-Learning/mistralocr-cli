{
  "name": "mistralocr-cli",
  "version": "1.0.0",
  "description": "CLI for the Mistral OCR API — converts documents and images to Markdown",
  "type": "module",
  "bin": {
    "mistralocr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ocr",
    "mistral",
    "pdf",
    "markdown",
    "cli",
    "document",
    "image-to-text",
    "pdf-to-markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pisanvs/mistralocr-cli.git"
  },
  "homepage": "https://github.com/pisanvs/mistralocr-cli#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
